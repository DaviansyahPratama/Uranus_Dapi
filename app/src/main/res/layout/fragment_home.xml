<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#004D98"
    tools:context=".Home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Header / Logo Kecil -->
            <ImageView
                android:id="@+id/imgLogoHeader"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Logo Barcelona"
                android:src="@drawable/barcelona"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitleMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MAIN MENU"
                android:textColor="#EDBB00"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogoHeader" />

            <!-- Tombol Ke Fourth Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToFourth"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Ke Fourth Activity"
                android:textColor="#004D98"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#EDBB00"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitleMain"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Tombol Ke Fifth Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToFiftth"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Ke Fifth Activity"
                android:textColor="#004D98"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#EDBB00"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnToFourth"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Tombol Ke Sixth Activity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToSixth"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Ke Sixth Activity"
                android:textColor="#004D98"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#EDBB00"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnToFiftth"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Tombol Pertemuan 9 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan9"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 9"
                android:textColor="#004D98"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#EDBB00"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnToSixth"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Tombol Pertemuan 10 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan10"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Pertemuan 10"
                android:textColor="#004D98"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#EDBB00"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPertemuan9"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Tombol Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="LOGOUT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#A50044"
                app:cornerRadius="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPertemuan10"
                app:layout_constraintWidth_percent="0.85" />

            <!-- Cat Fact Components -->
            <TextView
                android:id="@+id/tvCatFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Loading cat fact..."
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnLogout" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refresh"
                android:textColor="#004D98"
                app:backgroundTint="#EDBB00"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCatFact" />

            <!-- Photo Gallery Components -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnRefresh" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
