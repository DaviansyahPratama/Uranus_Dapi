<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#AA151B"
    android:padding="24dp"
    tools:context=".Home.Pertemuan_6.TigaFragment">

    <!-- Nomor Punggung Ikonik / Jersey Spanyol & Barca -->
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="19"
        android:textColor="#F1BF00"
        android:textSize="72sp"
        android:textStyle="bold" />

    <!-- Nama Player -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAMINE YAMAL"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Selebrasi Ikonik (304 - Rocafonda) -->
    <TextView
        android:id="@+id/tvCelebration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="304 ROCAFONDA"
        android:textColor="#F1BF00"
        android:textSize="18sp"
        android:textStyle="italic|bold" />

    <!-- Gelar / Julukan -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="The Golden Boy of La Masia"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>