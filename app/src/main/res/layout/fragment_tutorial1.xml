<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A50044"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgTutorial1"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@android:drawable/ic_dialog_info"
        android:tint="#EDBB00" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="BENVINGUTS!"
        android:textColor="#EDBB00"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Selamat datang di fitur pesan Uranus Dapi. Nikmati pengalaman obrolan kelas dunia!"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Més que un club"
        android:textColor="#EDBB00"
        android:textSize="14sp"
        android:textStyle="italic" />

</LinearLayout>